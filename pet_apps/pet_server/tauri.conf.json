{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust AI Desktop Pet",
  "version": "0.2.16",
  "identifier": "dev.rustai.pet",
  "build": { 
    "devUrl": "http://localhost:1420",
    "frontendDist": "../pet_ui/dist",
    "beforeDevCommand": {
      "script": "trunk serve --port 1420",
      "cwd": "../pet_ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../pet_ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pet 控制台",
        "width": 800,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true
      }
    ]
  },
  "bundle": { 
    "active": false 
  }
}
