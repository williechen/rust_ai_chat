{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust AI Desktop Pet",
  "version": "0.1.0",
  "identifier": "dev.rustai.desktop-pet",
  "build": { 
    "devUrl": "http://localhost:1420",
    "frontendDist": "frontend/dist",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../frontend"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { 
        "label": "main",
        "title": "Rust AI Desktop Pet",
        "width": 320,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ]
  },
  "bundle": { 
    "active": false 
  }
}
